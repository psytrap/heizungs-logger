[Unit]
Description=Heizungslogger (heat pump temperature logger)
Documentation=file:///home/ubuntu/heizungs_logger/README.md
After=network.target
# Retry forever: a missing USB adapter must not stop collection permanently.
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/heizungs_logger
ExecStart=/usr/bin/python3 /home/ubuntu/heizungs_logger/heizungs_logger.py --port /dev/ttyUSB0 --log_directory /home/ubuntu/heizungs_logger_logs
User=ubuntu
Group=ubuntu
# Unbuffered stdout so journal lines appear as they are written.
Environment=PYTHONUNBUFFERED=1
# `always`, not `on-failure`: a schedule slip or clean exit must not end collection.
Restart=always
RestartSec=10
SyslogIdentifier=heizungs_logger.py
StandardOutput=journal
StandardError=journal
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full

[Install]
WantedBy=multi-user.target
